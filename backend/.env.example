# Bookflow Backend Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
BOOKFLOW_DEBUG=false
ENVIRONMENT=development

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Self-hosted PP-OCRv6 service
PADDLEOCR_URL=http://127.0.0.1:8080/ocr
PADDLEOCR_TIMEOUT=60.0

# Optional Hugging Face fallback
# Get your API key from https://huggingface.co/settings/tokens
HF_TOKEN=
HF_API_KEY=
OCR_MODEL=
# Official OpenAI-compatible Hugging Face route for image-text-to-text models.
HF_INFERENCE_URL=https://router.huggingface.co/v1/chat/completions
HF_API_TIMEOUT=45.0
HF_MAX_RETRIES=3
HF_MAX_TOKENS=2048
OCR_PROMPT=Extract all text from this page exactly as written. Return only the extracted text in Markdown, preserving reading order, headings, tables, and line breaks.

# Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_BATCH_IMAGES=32
MAX_PDF_PAGES_OCR=1000
