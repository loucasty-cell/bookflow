# Bookflow Backend Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
ENVIRONMENT=development

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Hugging Face Configuration for Fast Image-to-Text OCR
# Get your API key from https://huggingface.co/settings/tokens
HF_TOKEN=
HF_API_KEY=
# Default HF OCR model (Image-to-Text / Vision)
# Options:
# - deepseek-ai/DeepSeek-OCR-2 (high-throughput vLLM visual OCR)
# - microsoft/trocr-base-stage1 (fast handwriting & printed OCR)
# - microsoft/trocr-large-printed (accurate printed text OCR)
# - stepfun-ai/GOT-OCR2_0 (General OCR Theory 2.0 - highly accurate)
# - facebook/nougat-base (academic and document OCR)
OCR_MODEL=deepseek-ai/DeepSeek-OCR-2
OCR_ENGINE_URL=http://ocr-engine:8000/v1
HF_OCR_MODEL=microsoft/trocr-base-stage1
HF_API_TIMEOUT=45.0
HF_MAX_RETRIES=3

# Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_BATCH_IMAGES=32
MAX_PDF_PAGES_OCR=1000
