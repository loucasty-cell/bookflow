{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Full Stack: Frontend + Backend",
      "configurations": ["Run Bookflow (Next.js)", "Run FastAPI Backend"]
    }
  ],
  "configurations": [
    {
      "name": "Run Bookflow (Next.js)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start Bookflow (Next.js)",
      "sourceMaps": true
    },
    {
      "name": "Run FastAPI Backend",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "Run current Python file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run current JavaScript file",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Run current Go package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${fileDirname}"
    },
    {
      "name": "Run current Dart file",
      "type": "dart",
      "request": "launch",
      "program": "${file}"
    }
  ]
}
