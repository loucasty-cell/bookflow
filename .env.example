# Bookflow Environment Configuration (Template)

# Server & Network Configuration
HOST=127.0.0.1
PORT=8000
BOOKFLOW_DEBUG=false
ENVIRONMENT=development

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional PaddleOCR self-hosted adapter and Hugging Face Qwen vision fallback
HF_TOKEN=
HF_API_KEY=
OCR_MODEL=Qwen/Qwen2-VL-7B-Instruct
HF_INFERENCE_URL=https://router.huggingface.co/v1/chat/completions
PADDLEOCR_URL=
PADDLEOCR_TIMEOUT=60.0
HF_API_TIMEOUT=45.0
HF_MAX_RETRIES=3
HF_MAX_TOKENS=2048
OCR_PROMPT=Extract all text from this page exactly as written. Return only the extracted text in Markdown, preserving reading order, headings, tables, and line breaks.

# Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_BATCH_IMAGES=32
MAX_PDF_PAGES_OCR=1000
