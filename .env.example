# Bookflow Environment Configuration (Template)

# Server & Network Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
ENVIRONMENT=development

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,*

# Hugging Face Vision & DeepSeek-OCR-2 Configuration
HF_TOKEN=
HF_API_KEY=
OCR_MODEL=deepseek-ai/DeepSeek-OCR-2
OCR_ENGINE_URL=http://ocr-engine:8000/v1
HF_API_TIMEOUT=45.0
HF_MAX_RETRIES=3

# Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_BATCH_IMAGES=32
MAX_PDF_PAGES_OCR=1000
